# Install as /etc/openframe/openframe.env (root:openframe, mode 0640).
# Replace the example values before starting the service.
NODE_ENV=production
BASE_URL=https://openframe.example.org
AUTH_SECRET=
DATABASE_PATH=/var/lib/openframe/openframe.db
BACKUP_DIRECTORY=/var/backups/openframe
OPENFRAME_DEMO=0
TRUST_PROXY=1
CONTENT_REMOVAL_CONTACT=
SECURITY_CONTACT=
