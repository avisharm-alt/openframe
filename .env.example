# Copy to .env.local and adjust. No external API keys are needed.

# Public URL of the site (used for auth callbacks and same-origin checks).
BASE_URL=http://localhost:3000

# Required in production: a long random string (e.g. `openssl rand -base64 48`).
AUTH_SECRET=

# SQLite database file. Back this file up (see docs/MAINTAINERS.md).
DATABASE_PATH=./data/openframe.db

# Where shared-note files are stored (default: a "notes" folder next to the database, i.e. on the same volume).
# Files are kept outside the database so database backups never contain them. Not needed unless you want another location.
# NOTES_DIR=./data/notes
# Hard cap on all stored note files together (default 1500). Keep it well below the volume size so uploads cannot fill the disk.
# NOTES_MAX_TOTAL_MB=1500

# Set to 1 only for local demos. Shows a demo banner and allows `npm run db:seed-demo`.
OPENFRAME_DEMO=0

# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Host.
TRUST_PROXY=0

# Maintainer-configured content-removal contact: a URL or mailto: link.
# Leave empty until a real address exists; the site will say that no contact is configured.
CONTENT_REMOVAL_CONTACT=
# Where to send security reports (documented in SECURITY.md); also shown on the privacy page if set.
SECURITY_CONTACT=

# Sign-in is Google only. Create an OAuth client in Google Cloud Console (see README, "Google sign-in"):
#   Authorized redirect URI:  <BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that become maintainers when they sign in with a Google-VERIFIED address.
# Use this to bootstrap the first maintainer on a host without shell access. Only promotes, never demotes.
INITIAL_MAINTAINER_EMAILS=

# Optional tuning of auth rate limits (per IP).
AUTH_SIGNUP_LIMIT_PER_HOUR=10
AUTH_SIGNIN_LIMIT_PER_MINUTE=10
