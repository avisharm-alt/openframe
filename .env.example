# Copy to .env.local and adjust. No external API keys are needed except Google sign-in in production.

# Public URL of the site (used for auth callbacks and same-origin checks).
BASE_URL=http://localhost:3000

# Required in production: a long random string (e.g. `openssl rand -base64 48`).
AUTH_SECRET=

# Required in production: a DIFFERENT long random string. It encrypts pickup addresses, access notes and phone
# numbers at rest (AES-256-GCM). Keep it out of git and out of backups of the database file.
PICKUP_ENCRYPTION_KEY=

# SQLite database file. Back this file up (see docs/OPERATIONS.md).
DATABASE_PATH=./data/openframe.db

# Set to 1 only for local demos. Shows a demo banner and allows `npm run db:seed-demo`.
OPENFRAME_DEMO=0

# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Host.
TRUST_PROXY=0

# A URL or mailto: link for questions, concerns and data-removal requests.
# Leave empty until a real, monitored address exists; the site will say that no contact is configured.
CONTACT_URL=
# Where to send security reports (documented in SECURITY.md); also shown on the privacy page if set.
SECURITY_CONTACT=

# Sign-in is Google only. Create an OAuth client in Google Cloud Console (see README, "Google sign-in"):
#   Authorized redirect URI:  <BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that become admins when they sign in with a Google-VERIFIED address.
# Use this to bootstrap the first admin on a host without shell access. Only promotes, never demotes.
# (The old name INITIAL_MAINTAINER_EMAILS is still read.)
INITIAL_ADMIN_EMAILS=

# Pickup safety settings. These defaults are the proposed policy; see docs/SAFETY-OPERATIONS.md.
# Erase a pickup's address, notes and phone this many days after the claim is collected, cancelled or a no-show.
PICKUP_PURGE_DAYS=7
# Coordinators and assigned volunteers can see an address from this many hours before the pickup window.
PICKUP_VISIBLE_HOURS_BEFORE=24
# A pickup still open this many hours after its window ended is flagged overdue to coordinators.
PICKUP_OVERDUE_HOURS=2
# A pickup claim that is not scheduled within this many hours is released and its request returns to the board.
CLAIM_RELEASE_HOURS=48
# Coordinators are alerted when an unfilled request is within this many days of its needed-by date.
REQUEST_RISK_DAYS=2

# Email: "console" (default, logs one line per message, no addresses or bodies) or "noop".
# A real provider is added by registering one in src/lib/email.ts; see docs/OPERATIONS.md.
EMAIL_PROVIDER=console

# Optional tuning of auth rate limits (per IP).
AUTH_SIGNUP_LIMIT_PER_HOUR=10
AUTH_SIGNIN_LIMIT_PER_MINUTE=10
