# Copy to .env.local and adjust. No external API keys are needed.

# Public URL of the site (used for auth callbacks and same-origin checks).
BASE_URL=http://localhost:3000

# Required in production: a long random string (e.g. `openssl rand -base64 48`).
AUTH_SECRET=

# SQLite database file. Back this file up (see docs/MAINTAINERS.md).
DATABASE_PATH=./data/openframe.db

# Set to 1 only for local demos. Shows a demo banner and allows `npm run db:seed-demo`.
OPENFRAME_DEMO=0

# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Host.
TRUST_PROXY=0

# Maintainer-configured content-removal contact: a URL or mailto: link.
# Leave empty until a real address exists; the site will say that no contact is configured.
CONTENT_REMOVAL_CONTACT=
# Where to send security reports (documented in SECURITY.md); also shown on the privacy page if set.
SECURITY_CONTACT=

# Who may create accounts: comma-separated email domains. Leave empty only for local demos.
# Setting this also turns on mandatory email verification (a domain check means nothing unless the address is proven).
ALLOWED_EMAIL_DOMAINS=uwo.ca

# Outgoing email (verification + password reset) via any SMTP provider. REQUIRED in production when
# ALLOWED_EMAIL_DOMAINS is set; the app refuses to start without it.
# Examples: smtps://user:password@smtp.your-provider.example:465
SMTP_URL=
EMAIL_FROM=OpenFrame <no-reply@your-domain.example>

# Optional tuning of auth rate limits (per IP).
AUTH_SIGNUP_LIMIT_PER_HOUR=10
AUTH_SIGNIN_LIMIT_PER_MINUTE=10
